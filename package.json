{
  "name": "pi-zai-models",
  "version": "1.2.0",
  "description": "pi extension: register Z.AI models with correct limits, thinking controls, and input modality, including GLM-5.3 / GLM-5.3-Flash Coding Plan support.",
  "keywords": [
    "context-window",
    "glm",
    "glm-5.2",
    "glm-5.3",
    "glm-5.3-flash",
    "models",
    "multimodal",
    "pi-extension",
    "pi-package",
    "provider",
    "vision",
    "zai"
  ],
  "license": "MIT",
  "author": "David Raistrick",
  "homepage": "https://github.com/keen99/pi-zai-models",
  "repository": {
    "type": "git",
    "url": "https://github.com/keen99/pi-zai-models.git"
  },
  "type": "module",
  "main": "./index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npx --yes tsx@4.20.6 --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "test:matrix": "node test/release-matrix.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.75.4",
    "typescript": "5.9.3"
  }
}
